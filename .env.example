NEXT_PUBLIC_MAPS=https://maps.app.goo.gl/dsZvoZ6Va3HsuxCG9

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Security & JWT Authentication
SECRET_KEY=change-this-super-secret-key-infotech-2026-xyz987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (used by init.sql / seed script)
ADMIN_EMAIL=admin@infotechsoftware.com
ADMIN_PASSWORD=AdminSecurePassword2026!
ADMIN_NAME="Mohammad Shahabuddin"

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=infotech_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/infotech_db
# Local development outside docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/infotech_db

# ==========================================
# AI & Automation Services
# ==========================================
# Optional: Set Gemini or OpenAI API Key for live AI responses
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_MODEL=gemini-1.5-flash

# Voice Agent Configuration
VOICE_AGENT_NAME="Aria"
VOICE_DEFAULT_LANGUAGE=en-US

# ==========================================
# WhatsApp Business Cloud API Integration
# ==========================================
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=infotech_webhook_verification_token_2026
