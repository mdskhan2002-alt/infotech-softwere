AGENCY_GOOGLE_MAPS_URL="https://maps.app.goo.gl/dsZvoZ6Va3HsuxCG9"

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AGENCY_EMAIL=mdskhan2002@gmail.com
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/in/mohammad-shahabuddin-887832343?utm_source=share_via&utm_content=profile&utm_medium=member_android
